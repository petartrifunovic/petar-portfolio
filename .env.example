# Public origin - every canonical link and share card is built from it.
NEXT_PUBLIC_SITE_URL=https://www.petartrifunovic.com

# Mapbox — https://account.mapbox.com/access-tokens/ (public token, pk.*)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Corals journal API (server-side only — no CORS, no key needed)
CORALS_API_URL=https://api.corals.studio
NEXT_PUBLIC_JOURNAL_URL=https://corals.studio/journal

# Contact form (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
CONTACT_RECEIVER_EMAIL=
